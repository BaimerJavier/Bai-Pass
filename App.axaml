<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PasswordManager.App"
             xmlns:local="using:PasswordManager"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <!-- Modern dark palette -->
        <Color x:Key="AppBackground">#0E0F14</Color>
        <Color x:Key="AppSurface">#171922</Color>
        <Color x:Key="AppSurfaceAlt">#1E2130</Color>
        <Color x:Key="AppBorder">#2A2E3D</Color>
        <Color x:Key="AppAccent">#7C5CFC</Color>
        <Color x:Key="AppAccentHover">#9179FF</Color>
        <Color x:Key="AppTextMuted">#8A90A2</Color>

        <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackground}" />
        <SolidColorBrush x:Key="AppSurfaceBrush" Color="{StaticResource AppSurface}" />
        <SolidColorBrush x:Key="AppSurfaceAltBrush" Color="{StaticResource AppSurfaceAlt}" />
        <SolidColorBrush x:Key="AppBorderBrush" Color="{StaticResource AppBorder}" />
        <SolidColorBrush x:Key="AppAccentBrush" Color="{StaticResource AppAccent}" />
        <SolidColorBrush x:Key="AppAccentHoverBrush" Color="{StaticResource AppAccentHover}" />
        <SolidColorBrush x:Key="AppTextMutedBrush" Color="{StaticResource AppTextMuted}" />

        <!-- Drive Fluent's accent (selection, focus, default button) to our violet -->
        <Color x:Key="SystemAccentColor">#7C5CFC</Color>
        <Color x:Key="SystemAccentColorDark1">#6D4CF0</Color>
        <Color x:Key="SystemAccentColorDark2">#5C3FD6</Color>
        <Color x:Key="SystemAccentColorDark3">#4A32B0</Color>
        <Color x:Key="SystemAccentColorLight1">#9179FF</Color>
        <Color x:Key="SystemAccentColorLight2">#A896FF</Color>
        <Color x:Key="SystemAccentColorLight3">#C0B3FF</Color>

        <!-- Icon geometries (Material-style, 24x24 viewbox) -->
        <StreamGeometry x:Key="IconLock">M12 17a2 2 0 0 0 2-2 2 2 0 0 0-2-2 2 2 0 0 0-2 2 2 2 0 0 0 2 2m6-9a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V10a2 2 0 0 1 2-2h1V6a5 5 0 0 1 5-5 5 5 0 0 1 5 5v2h1m-6-5a3 3 0 0 0-3 3v2h6V6a3 3 0 0 0-3-3z</StreamGeometry>
        <StreamGeometry x:Key="IconKey">M7 14a2 2 0 0 1-2-2 2 2 0 0 1 2-2 2 2 0 0 1 2 2 2 2 0 0 1-2 2m5.65-4A5.99 5.99 0 0 0 7 6a6 6 0 0 0-6 6 6 6 0 0 0 6 6 5.99 5.99 0 0 0 5.65-4H17v4h4v-4h2v-4H12.65z</StreamGeometry>
        <StreamGeometry x:Key="IconCopy">M19 21H8V7h11m0-2H8a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2m-3-4H4a2 2 0 0 0-2 2v14h2V3h12V1z</StreamGeometry>
        <StreamGeometry x:Key="IconEye">M12 9a3 3 0 0 1 3 3 3 3 0 0 1-3 3 3 3 0 0 1-3-3 3 3 0 0 1 3-3m0-4.5c5 0 9.27 3.11 11 7.5-1.73 4.39-6 7.5-11 7.5S2.73 16.39 1 12c1.73-4.39 6-7.5 11-7.5M3.18 12a9.821 9.821 0 0 0 17.64 0 9.821 9.821 0 0 0-17.64 0z</StreamGeometry>
        <StreamGeometry x:Key="IconRefresh">M17.65 6.35A7.958 7.958 0 0 0 12 4a8 8 0 0 0-8 8 8 8 0 0 0 8 8c3.73 0 6.84-2.55 7.73-6h-2.08A5.99 5.99 0 0 1 12 18a6 6 0 0 1-6-6 6 6 0 0 1 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z</StreamGeometry>
        <StreamGeometry x:Key="IconTrash">M19 4h-3.5l-1-1h-5l-1 1H5v2h14M6 19a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V7H6v12z</StreamGeometry>
        <StreamGeometry x:Key="IconSave">M15 9H5V5h10m-3 14a3 3 0 0 1-3-3 3 3 0 0 1 3-3 3 3 0 0 1 3 3 3 3 0 0 1-3 3m3-16H5c-1.11 0-2 .9-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V7l-4-4z</StreamGeometry>
        <StreamGeometry x:Key="IconSearch">M9.5 3A6.5 6.5 0 0 1 16 9.5c0 1.61-.59 3.09-1.56 4.23l.27.27h.79l5 5-1.5 1.5-5-5v-.79l-.27-.27A6.516 6.516 0 0 1 9.5 16 6.5 6.5 0 0 1 3 9.5 6.5 6.5 0 0 1 9.5 3m0 2C7 5 5 7 5 9.5S7 14 9.5 14 14 12 14 9.5 12 5 9.5 5z</StreamGeometry>
        <StreamGeometry x:Key="IconFolder">M10 4H4c-1.11 0-2 .89-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-8l-2-2z</StreamGeometry>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- Window base -->
        <Style Selector="Window">
            <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}" />
        </Style>

        <!-- Rounded, larger inputs -->
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="MinHeight" Value="38" />
        </Style>

        <!-- Buttons: rounded, roomy -->
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="MinHeight" Value="38" />
        </Style>

        <!-- Accent (primary) button -->
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="{StaticResource AppAccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AppAccentHoverBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.accent:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AppAccentBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- Danger (destructive) button -->
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="#E5484D" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#F0575C" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.danger:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#CC3E42" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- ListBox items: rounded rows with a soft selection -->
        <Style Selector="ListBoxItem">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Margin" Value="4,2" />
            <Setter Property="Padding" Value="10,8" />
        </Style>

        <!-- Entry rows inside folder groups (clickable, flat, with selection highlight) -->
        <Style Selector="Button.entryrow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="0,1" />
        </Style>
        <Style Selector="Button.entryrow:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#22FFFFFF" />
        </Style>
        <Style Selector="Button.entryrow.selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AppAccentBrush}" />
            <Setter Property="TextElement.Foreground" Value="White" />
        </Style>

        <!-- ListBox surface -->
        <Style Selector="ListBox">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Application.Styles>
</Application>
